<Project>
  <!-- Shared build settings for every project in the repo (all editions). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <Authors>ContentCalendar contributors</Authors>
    <Company>ContentCalendar</Company>
    <Copyright>Copyright © ContentCalendar contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>umbraco;umbraco-marketplace;calendar;content;scheduling;dashboard</PackageTags>

    <!-- Opt-in per project: Core and each edition package (ContentCalendar.Vxx) are packable. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>

