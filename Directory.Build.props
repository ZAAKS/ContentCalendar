<Project>
  <!-- Shared build settings for every project in the repo (all editions). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Version>1.0.0</Version>
    <Authors>ZAAKS!</Authors>
    <Company>ZAAKS!</Company>
    <Product>Content Calendar</Product>
    <Copyright>Copyright © 2026 ZAAKS!</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ZAAKS/ContentCalendar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ZAAKS/ContentCalendar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Only the installable edition package (ContentCalendar.Vxx) adds the umbraco-marketplace tag. -->
    <PackageTags>umbraco;umbraco-cms;calendar;content-calendar</PackageTags>

    <!-- Opt-in per project: Core and each edition package (ContentCalendar.Vxx) are packable. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>

